---
import { faqLd } from '../lib/schema';
const { items, heading = 'Common questions' } = Astro.props as { items: { q: string; a: string }[]; heading?: string };
---
<section class="faq sr">
  <h2>{heading}</h2>
  {items.map((i) => <><h3>{i.q}</h3><p>{i.a}</p></>)}
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqLd(items))}></script>

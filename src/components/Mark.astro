---
// The Inkdrop, from the supplied brand kit (mark_source.svg), geometry and
// gradients unaltered per the brief. Renders drop-only; the ripple rings are a
// separate component so animation states can use them independently.
interface Props { size?: number }
const { size = 22 } = Astro.props;
---
<svg width={size} viewBox="380 270 264 350" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="inkdrop">
  <defs>
    <radialGradient id="dropA" cx="0.38" cy="0.30" r="0.9">
      <stop offset="0" stop-color="#324A78"/><stop offset="0.45" stop-color="#1E2E52"/><stop offset="1" stop-color="#131F3B"/>
    </radialGradient>
    <radialGradient id="sheenA" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#BFD0F0" stop-opacity="0.9"/><stop offset="1" stop-color="#BFD0F0" stop-opacity="0"/>
    </radialGradient>
    <filter id="bleedA" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="9" result="t"/>
      <feDisplacementMap in="SourceGraphic" in2="t" scale="5" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </defs>
  <g filter="url(#bleedA)">
    <path d="M512 300 C 566 392, 606 452, 606 508 a 94 94 0 1 1 -188 0 C 418 452, 458 392, 512 300 Z" fill="url(#dropA)"/>
  </g>
  <ellipse cx="488" cy="470" rx="22" ry="52" fill="url(#sheenA)" opacity="0.9" transform="rotate(-12 488 470)"/>
</svg>

---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { articleLd } from '../../lib/schema';
import { SITE } from '../../lib/site';
import { formatDate } from '../../lib/registry';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const crumbs = [
  { name: 'Home', url: '/' }, { name: 'Guides', url: '/guides/' },
  { name: g.data.title, url: `/guides/${g.id}/` },
];
---
<Base
  title={`${g.data.title} | Inkline`}
  description={g.data.description}
  path={`/guides/${g.id}/`}
  crumbs={crumbs}
  jsonld={[articleLd({ title: g.data.title, description: g.data.description, slug: g.id, published: g.data.published, modified: g.data.modified })]}
>
  <article>
    <p class="kicker">Guide</p>
    <h1>{g.data.title}</h1>
    <p class="dateline">By <a href="/about/">{SITE.author.name}</a> · Published {formatDate(g.data.published)} · Last updated {formatDate(g.data.modified)}</p>
    <div class="prose" style="margin-top:1.4rem">
      <Content />
    </div>
    <aside class="related">
      <p class="small"><strong style="font-weight:600">{SITE.author.name}</strong>: {SITE.author.title}, Wikipedia editor, and Inkline's developer. {SITE.boilerplate}</p>
    </aside>
  </article>
</Base>

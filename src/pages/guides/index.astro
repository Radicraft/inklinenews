---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/registry';
const guides = (await getCollection('guides')).sort((a, b) => b.data.published.localeCompare(a.data.published));
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Guides', url: '/guides/' }];
---
<Base
  title="Guides to RSS, feeds and media monitoring | Inkline"
  description="Long-form, dated and authored reference pieces on RSS in 2026, monitoring workflows and which publications still publish feeds."
  path="/guides/"
  crumbs={crumbs}
>
  <p class="kicker">Editorial</p>
  <h1>Guides</h1>
  <p class="prose">Reference pieces, written by a person who does this for a living, dated and updated when the facts change. Three further guides are in draft for launch: the fifteen-minute monitoring workflow, RSS in 2026, and building a media list for a listed company.</p>
  <ul class="pub-list">
    {guides.map((g) => (
      <li><a href={`/guides/${g.id}/`}>{g.data.title}</a><span class="country">Updated {formatDate(g.data.modified)}</span></li>
    ))}
  </ul>
</Base>

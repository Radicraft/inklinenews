---
import Base from '../../layouts/Base.astro';
import { publications, REGISTRY, formatDate, REGISTRY_UPDATED } from '../../lib/registry';

export function getStaticPaths({ paginate }) {
  const sorted = [...publications].sort((a, b) => a.name.localeCompare(b.name));
  return paginate(sorted, { pageSize: 50 });
}
const { page } = Astro.props;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Publications', url: '/publications/' }];
---
<Base
  title={`All ${REGISTRY.sources} publications in Inkline's registry, page ${page.currentPage} | Inkline`}
  description={`The source registry behind Inkline: ${REGISTRY.sources} publications across ${REGISTRY.markets} markets and ${REGISTRY.languages} languages, updated ${formatDate(REGISTRY_UPDATED)}.`}
  path={page.currentPage === 1 ? '/publications/' : `/publications/${page.currentPage}/`}
  crumbs={crumbs}
>
  <p class="kicker">The registry</p>
  <h1>All {REGISTRY.sources} publications</h1>
  <p class="answer">Inkline's source registry covers {REGISTRY.sources} publications across {REGISTRY.markets} markets and {REGISTRY.languages} languages, chosen by hand and feed-verified before every release. Updated {formatDate(REGISTRY_UPDATED)}. Names and markets are listed here; each linked title has a detail page.</p>
  <ul class="publist">
    {page.data.map((p) => (
      <li>
        {p.hasPage ? <a href={`/publications/${p.slug}/`}>{p.name}</a> : <span>{p.name}</span>}
        <span class="small"> · {p.market}</span>
      </li>
    ))}
  </ul>
  <nav class="pager" aria-label="Pages">
    {page.url.prev && <a href={page.url.prev}>Previous</a>}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next && <a href={page.url.next}>Next</a>}
  </nav>
</Base>

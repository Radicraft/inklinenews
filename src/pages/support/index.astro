---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Support', url: '/support/' }];
const topics = [
  { slug: 'adding-sources', name: 'Adding sources' },
  { slug: 'daily-briefs', name: 'Daily briefs' },
  { slug: 'offline-reading', name: 'Offline reading' },
  { slug: 'ipad-and-pencil', name: 'iPad and Apple Pencil' },
  { slug: 'inkline-radio', name: 'Inkline Radio' },
  { slug: 'keywords', name: 'Keywords and the Watch tab' },
  { slug: 'coverage-reports', name: 'Coverage reports' },
  { slug: 'subscription-and-trial', name: 'Free tier, Pro and billing' },
  { slug: 'restoring-purchases', name: 'Restoring purchases' },
  { slug: 'troubleshooting-monitors', name: 'Troubleshooting monitors' },
];
const faq = [
  { q: 'Does Inkline require an account?', a: 'No. Inkline has no accounts and no server; everything runs on your device. Your subscription belongs to your Apple Account, which is also how it restores on a new device.' },
  { q: 'Which devices does Inkline support?', a: 'Inkline is a universal iPhone and iPad app. Apple Intelligence features, including daily briefs and summarisation, require a device that supports Apple Intelligence.' },
  { q: 'Why can\u2019t I see feed URLs anywhere?', a: 'The verified feed endpoints are delivered inside the app rather than published on this site. Publication pages list market, language, coverage and access status, which answer the question of what is covered without exposing the registry.' },
  { q: 'How do I report a problem with a source?', a: 'Email the address below and name the publication. Every feed is machine-verified before each release, but a report moves a title to the front of the queue.' },
  { q: 'How do I manage or cancel Inkline Pro?', a: 'Subscriptions belong to your Apple Account, not to us. On your device: Settings, then your name, then Subscriptions, then Inkline. You can switch between monthly and annual, or cancel, and Pro keeps working until the end of the paid period. Cancelling during the free week means you are never charged.' },
  { q: 'How do I get a refund?', a: 'Apple handles all payments, so refunds come from Apple: sign in at reportaproblem.apple.com, find the Inkline charge and choose Request a refund. We never see your payment details, so we cannot issue refunds directly.' },
  { q: 'I subscribed but Pro features are locked. What do I do?', a: 'Open Inkline settings and tap Restore Purchases; the subscription is read back from your Apple Account. This is also the fix on a new device. If it still fails, check you are signed in with the same Apple Account that bought the subscription.' },
  { q: 'Can I import my subscriptions from another reader?', a: 'Yes. Export an OPML file from your current reader and open it with Inkline, or use the import option in settings. Your publications arrive as a set; the free tier reads up to 50 of them. Since 1.6 you can also export your publications as OPML, so the list is yours to take away.' },
  { q: 'What does Inkline require?', a: 'iOS 18 or later on iPhone or iPad. Apple Intelligence features (Today’s Brief, Compare Coverage, Inkline Radio) additionally need a device that supports Apple Intelligence.' },
];
---
<Base
  title="Inkline support and help centre | Inkline"
  description="Help with adding sources, daily briefs, offline reading, iPad and Pencil, subscriptions and troubleshooting monitors, plus common questions."
  path="/support/"
  crumbs={crumbs}
>
  <div slot="masthead">
  <p class="kicker">Support</p>
  <h1>Help centre</h1>
  </div>
  <p class="prose">One page per topic, kept short and current. If a question isn't answered here, the contact route at the foot reaches a person.</p>
  <ul class="pub-list">
    {topics.map((t) => <li><a href={`/support/${t.slug}/`}>{t.name}</a></li>)}
  </ul>
  <Faq items={faq} heading="Frequently asked" />
  <div class="prose sr">
    <h2>Contact</h2>
    <p>Email <a href="mailto:hello@inklinenews.com">hello@inklinenews.com</a> and a person answers. Naming the app version and your device helps; Settings inside the app shows both.</p>
  </div>
</Base>

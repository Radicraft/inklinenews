# inklinenews.com on SiteGround (Apache). Static Astro output.

# Canonical host and HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://inklinenews.com%{REQUEST_URI} [L,R=301]

# Legacy path shapes (ported from _redirects)
Redirect 301 /Privacy-Policy /privacy/
Redirect 301 /privacy-policy /privacy/
Redirect 301 /Support /support/
Redirect 301 /support.html /support/
Redirect 301 /press-kit /press/
Redirect 301 /app/features/watchwords /app/features/keywords/

# Hashed assets are immutable; HTML revalidates
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "https://inklinenews.com"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddType font/woff2 .woff2
ErrorDocument 404 /404.html
# Registry v3 (Aug 2026): retired publication pages
Redirect 301 /publications/interia-film/ /feeds/poland/
Redirect 301 /publications/interia-gry/ /feeds/poland/
Redirect 301 /publications/interia-kobieta/ /feeds/poland/
Redirect 301 /publications/interia-mam-dziecko/ /feeds/poland/
Redirect 301 /publications/interia-motoryzacja/ /feeds/poland/
Redirect 301 /publications/interia-nieruchomosci/ /feeds/poland/
Redirect 301 /publications/interia-pogoda/ /feeds/poland/
Redirect 301 /publications/interia-porady/ /feeds/poland/
Redirect 301 /publications/interia-sport/ /feeds/poland/
Redirect 301 /publications/interia-styl/ /feeds/poland/
Redirect 301 /publications/magazyn-auto/ /feeds/poland/
Redirect 301 /publications/menway/ /feeds/poland/
Redirect 301 /publications/onet-podroze/ /feeds/poland/
Redirect 301 /publications/swiat-seriali/ /feeds/poland/
Redirect 301 /publications/wp-gwiazdy/ /feeds/poland/
Redirect 301 /publications/wp-kobieta/ /feeds/poland/
Redirect 301 /publications/wp-moto/ /feeds/poland/
